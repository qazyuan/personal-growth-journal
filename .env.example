NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 密钥只能配置在本地或 Vercel 服务端环境中，不能加 NEXT_PUBLIC_ 前缀。
# 智谱或 DeepSeek：AI_PROVIDER 分别填 zhipu / deepseek；AI_BASE_URL 可留空。
# 其他兼容 OpenAI Chat Completions 的服务：填写自定义 AI_PROVIDER 和 AI_BASE_URL。
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=your-server-side-ai-key
AI_MODEL=deepseek-flash
AI_FALLBACK_MODEL=deepseek-v4-pro

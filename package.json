{
  "name": "personal-growth-journal",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npm run dev -w @journal/web",
    "dev:web": "npm run dev -w @journal/web",
